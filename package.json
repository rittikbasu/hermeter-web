    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "shadcn-svelte": "^1.4.2",
    "svelte": "5.56.5",
    "svelte-check": "4.7.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
