{
  "name": "hermeter-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm test && pnpm check && pnpm build",
    "db:migrate": "wrangler d1 migrations apply hermeter --local",
    "cf:dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260715.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "svelte": "5.56.5",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.111.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.24.0"
  }
}
