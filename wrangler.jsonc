{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermeter-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hermeter.rittik.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "42936a1c4ef345d88ed65096b884030e"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hermeter",
      "database_id": "06f9b728-a4b5-42da-bdff-9149557ffb55",
      "migrations_dir": "migrations"
    }
  ]
}
